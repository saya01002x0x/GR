generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                      String             @id @default(uuid())
  clerkId                 String             @unique @map("clerk_id")
  email                   String             @unique
  username                String             @unique
  displayName             String?            @map("display_name")
  avatar                  String?
  banner                  String?
  bio                     String?
  stripeCustomerId        String?            @unique @map("stripe_customer_id")
  role                    UserRole           @default(USER)
  isArtist                Boolean            @default(false) @map("is_artist")
  isBanned                Boolean            @default(false) @map("is_banned")
  bannedAt                DateTime?          @map("banned_at")
  bannedUntil             DateTime?          @map("banned_until")
  bannedById              String?            @map("banned_by_id")
  warningCount            Int                @default(0) @map("warning_count")
  preferences             Json?
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  artworks                Artwork[]
  bookmarks               Bookmark[]
  collections             Collection[]
  comments                Comment[]
  following               Follow[]           @relation("following")
  followers               Follow[]           @relation("followers")
  likes                   Like[]
  reportsFiled            Report[]           @relation("reports_filed")
  reportsResolved         Report[]           @relation("reports_resolved")
  announcements           Announcement[]
  auditLogs               AuditLog[]
  warnings                UserWarning[]
  notifications           Notification[]
  subscription            Subscription?
  tierSubscriptions       TierSubscription[] @relation("tier_subscriber")
  tierSubscribersAsArtist TierSubscription[] @relation("tier_artist")
  artistTiers             ArtistTier[]
  payouts                 Payout[]           @relation("payout_artist")
  approvedPayouts         Payout[]           @relation("payout_approver")
  payments                Payment[]
  interactions            UserInteraction[]
  notificationPreferences NotificationPreference?

  @@map("users")
}

model Artwork {
  id             String            @id @default(uuid())
  title          String
  description    String?
  type           ArtworkType       @default(ILLUSTRATION)
  status         ArtworkStatus     @default(PUBLISHED)
  rating         ContentRating     @default(SAFE)
  isAI           Boolean           @default(false) @map("is_ai")
  viewCount      Int               @default(0) @map("view_count")
  likeCount      Int               @default(0) @map("like_count")
  commentCount   Int               @default(0) @map("comment_count")
  ratioClass     String?           @map("ratio_class")
  maxResolution  Int?              @map("max_resolution")
  isHighRes      Boolean           @default(false) @map("is_high_res")
  visibility     ArtworkVisibility @default(PUBLIC) @map("visibility")
  requiredTierId String?           @map("required_tier_id")
  isPromoted     Boolean           @default(false) @map("is_promoted")
  promotedAt     DateTime?         @map("promoted_at")
  promotedUntil  DateTime?         @map("promoted_until")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  authorId       String            @map("author_id")
  images         ArtworkImage[]
  tags           ArtworkTag[]
  author         User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  requiredTier   ArtistTier?       @relation("ArtworkRequiredTier", fields: [requiredTierId], references: [id], onDelete: SetNull)
  bookmarks      Bookmark[]
  comments       Comment[]
  likes          Like[]
  reports        Report[]
  tierContents   TierContent[]
  warnings       UserWarning[]
  interactions   UserInteraction[]

  @@index([authorId])
  @@index([requiredTierId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
  @@map("artworks")
}

model ArtworkImage {
  id            String                      @id @default(uuid())
  originalUrl   String?                     @map("original_url")
  url           String
  order         Int                         @default(0)
  width         Int?
  height        Int?
  status        ImageStatus                 @default(PENDING)
  errorMetadata Json?                       @map("error_metadata")
  createdAt     DateTime                    @default(now()) @map("created_at")
  artworkId     String                      @map("artwork_id")
  aspectRatio   Float?                      @map("aspect_ratio")
  thumbnailUrl  String?                     @map("thumbnail_url")
  blurredUrl    String?                     @map("blurred_url")
  phash         String?                     @map("phash")
  embedding     Unsupported("vector(512)")? @map("embedding")
  hasEmbedding  Boolean                     @default(false) @map("has_embedding")
  artwork       Artwork                     @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([artworkId])
  @@index([phash])
  @@index([status])
  @@map("artwork_images")
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @unique
  count     Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")
  artworks  ArtworkTag[]

  @@map("tags")
}

model ArtworkTag {
  artworkId String  @map("artwork_id")
  tagId     String  @map("tag_id")
  order     Int     @default(0)
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([artworkId, tagId])
  @@map("artwork_tags")
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  userId    String    @map("user_id")
  artworkId String    @map("artwork_id")
  parentId  String?   @map("parent_id")
  artwork   Artwork   @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([artworkId])
  @@index([userId])
  @@map("comments")
}

model Like {
  userId    String   @map("user_id")
  artworkId String   @map("artwork_id")
  createdAt DateTime @default(now()) @map("created_at")
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, artworkId])
  @@map("likes")
}

model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

model Collection {
  id          String     @id @default(uuid())
  name        String
  description String?
  isPrivate   Boolean    @default(true) @map("is_private")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  userId      String     @map("user_id")
  isDefault   Boolean    @default(false) @map("is_default")
  bookmarks   Bookmark[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("collections")
}

model Bookmark {
  id           String     @id @default(uuid())
  createdAt    DateTime   @default(now()) @map("created_at")
  userId       String     @map("user_id")
  artworkId    String     @map("artwork_id")
  collectionId String     @map("collection_id")
  artwork      Artwork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artworkId, collectionId])
  @@index([userId])
  @@index([artworkId])
  @@index([collectionId])
  @@map("bookmarks")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum ArtworkType {
  ILLUSTRATION
  MANGA
}

enum ArtworkStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  PROCESSING
  FAILED
  HIDDEN
  ACTION_REQUIRED
  IN_REVIEW
}

enum ContentRating {
  SAFE
}

enum ImageStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ArtworkVisibility {
  PUBLIC
  TIER_GATED
}

model Report {
  id           String       @id @default(uuid())
  reason       ReportReason
  description  String?
  status       ReportStatus @default(PENDING)
  artworkId    String?      @map("artwork_id")
  reporterId   String       @map("reporter_id")
  resolvedById String?      @map("resolved_by_id")
  resolution   String?
  resolvedAt   DateTime?    @map("resolved_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  artwork      Artwork?     @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  reporter     User         @relation("reports_filed", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?        @relation("reports_resolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([artworkId])
  @@map("reports")
}

enum ReportReason {
  SPAM
  NSFW
  DUPLICATE
  COPYRIGHT
  HARASSMENT
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Announcement {
  id        String           @id @default(uuid())
  title     String
  content   String
  type      AnnouncementType @default(INFO)
  isActive  Boolean          @default(true) @map("is_active")
  expiresAt DateTime?        @map("expires_at")
  authorId  String           @map("author_id")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

enum AnnouncementType {
  INFO
  WARNING
  MAINTENANCE
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  details    Json?
  targetId   String?  @map("target_id")
  targetType String?  @map("target_type")
  actorId    String   @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model UserWarning {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  artworkId String?  @map("artwork_id")
  reason    String
  note      String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork? @relation(fields: [artworkId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_warnings")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  data      Json?
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model NotificationPreference {
  id                String  @id @default(uuid())
  userId            String  @unique @map("user_id")
  
  followWeb         Boolean @default(true)  @map("follow_web")
  likeWeb           Boolean @default(true)  @map("like_web")
  commentWeb        Boolean @default(true)  @map("comment_web")
  mentionWeb        Boolean @default(true)  @map("mention_web")
  newArtworkWeb     Boolean @default(true)  @map("new_artwork_web")
  
  weeklyNewsletter  Boolean @default(true)  @map("weekly_newsletter")
  productUpdates    Boolean @default(true)  @map("product_updates")
  
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notification_preferences")
}

enum NotificationType {
  WARNING
  TEMP_BAN
  UNBAN
  SYSTEM
  LIKE
  COMMENT
  FOLLOW
  NEW_ARTWORK
}

// ============================================
// PAYMENT & SUBSCRIPTION MODELS
// ============================================

model Plan {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("VND")
  features    Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String             @map("user_id")
  planId            String             @map("plan_id")
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd  DateTime?          @map("current_period_end")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  provider          PaymentProvider    @default(PAYPAL)
  providerSubId     String?            @map("provider_sub_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([userId])
  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model ArtistTier {
  id           String   @id @default(uuid())
  artistId     String   @map("artist_id")
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  currency     String   @default("VND")
  benefits     Json     @default("[]")
  maxMembers   Int?     @map("max_members")
  isActive     Boolean  @default(true) @map("is_active")
  isArchived   Boolean  @default(false) @map("is_archived")
  parentTierId String?  @map("parent_tier_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  artist        User               @relation(fields: [artistId], references: [id], onDelete: Cascade)
  parentTier    ArtistTier?        @relation("TierHierarchy", fields: [parentTierId], references: [id])
  subTiers      ArtistTier[]       @relation("TierHierarchy")
  subscriptions TierSubscription[]
  contents      TierContent[]
  gatedArtworks Artwork[]          @relation("ArtworkRequiredTier")

  @@index([artistId])
  @@index([parentTierId])
  @@map("artist_tiers")
}

model TierSubscription {
  id                String             @id @default(uuid())
  tierId            String             @map("tier_id")
  subscriberId      String             @map("subscriber_id")
  artistId          String             @map("artist_id")
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd  DateTime?          @map("current_period_end")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  provider          PaymentProvider    @default(PAYPAL)
  providerSubId     String?            @map("provider_sub_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  tier       ArtistTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  subscriber User       @relation("tier_subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  artist     User       @relation("tier_artist", fields: [artistId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@index([tierId])
  @@index([subscriberId])
  @@index([artistId])
  @@index([status])
  @@map("tier_subscriptions")
}

model TierContent {
  id          String   @id @default(uuid())
  tierId      String   @map("tier_id")
  artworkId   String   @map("artwork_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tier    ArtistTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  artwork Artwork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([tierId, artworkId])
  @@map("tier_contents")
}

model Payment {
  id                    String          @id @default(uuid())
  userId                String          @map("user_id")
  provider              PaymentProvider
  providerTransactionId String?         @map("provider_txn_id")
  amount                Decimal         @db.Decimal(10, 2)
  currency              String          @default("VND")
  type                  PaymentType
  status                PaymentStatus   @default(PENDING)
  metadata              Json?           @default("{}")
  createdAt             DateTime        @default(now()) @map("created_at")

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription       Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId     String?           @map("subscription_id")
  tierSubscription   TierSubscription? @relation(fields: [tierSubscriptionId], references: [id], onDelete: SetNull)
  tierSubscriptionId String?           @map("tier_subscription_id")
  invoice            Invoice?

  @@index([userId])
  @@index([providerTransactionId])
  @@index([status])
  @@index([type])
  @@map("payments")
}

model Invoice {
  id        String        @id @default(uuid())
  paymentId String        @unique @map("payment_id")
  items     Json          @default("[]")
  total     Decimal       @db.Decimal(10, 2)
  status    InvoiceStatus @default(PAID)
  pdfUrl    String?       @map("pdf_url")
  createdAt DateTime      @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Payout {
  id              String       @id @default(uuid())
  artistId        String       @map("artist_id")
  amount          Decimal      @db.Decimal(10, 2)
  fee             Decimal      @default(0) @db.Decimal(10, 2)
  netAmount       Decimal      @map("net_amount") @db.Decimal(10, 2)
  status          PayoutStatus @default(PENDING)
  note            String?
  requestedAt     DateTime     @default(now()) @map("requested_at")
  approvedAt      DateTime?    @map("approved_at")
  approvedBy      String?      @map("approved_by")
  paidAt          DateTime?    @map("paid_at")
  rejectedAt      DateTime?    @map("rejected_at")
  rejectionReason String?      @map("rejection_reason")

  artist   User  @relation("payout_artist", fields: [artistId], references: [id], onDelete: Cascade)
  approver User? @relation("payout_approver", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([artistId])
  @@index([status])
  @@map("payouts")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum PaymentProvider {
  PAYPAL
  STRIPE
}

enum PaymentType {
  SUBSCRIPTION
  TIER_SUBSCRIPTION
  PAYOUT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  PAID
  UNPAID
  VOID
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model UserInteraction {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  artworkId String          @map("artwork_id")
  action    InteractionType
  weight    Int             @default(1)
  createdAt DateTime        @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([userId, artworkId, action])
  @@index([userId])
  @@index([artworkId])
  @@map("user_interactions")
}

enum InteractionType {
  VIEW
  LIKE
  COMMENT
  UNLOCK
}
