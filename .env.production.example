# ============================================
# Environment Variables - PRODUCTION
# Lumina Project (luminaaaa.studio)
# ============================================
# Copy file này thành .env rồi điền thông tin thật:
#   cp .env.production.example .env
# ============================================

# ============================================
# DOMAIN & URLs
# ============================================
NEXT_PUBLIC_APP_URL=https://luminaaaa.studio
NEXT_PUBLIC_API_URL=https://api.luminaaaa.studio

# ============================================
# POSTGRESQL
# ⚠️ ĐỔI PASSWORD THÀNH PASSWORD MẠNH!
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_123
POSTGRES_DB=gr_production
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD_123@postgres:5432/gr_production

# ============================================
# MEILISEARCH
# ⚠️ ĐỔI API KEY!
# ============================================
MEILISEARCH_API_KEY=CHANGE_ME_meilisearch_master_key_production

# ============================================
# MINIO (Object Storage - Ảnh/File)
# ⚠️ ĐỔI USER VÀ PASSWORD!
# ============================================
MINIO_ROOT_USER=lumina_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_123
AWS_REGION=us-east-1
AWS_BUCKET_NAME=lumina-artworks

# ============================================
# CLERK AUTHENTICATION
# 🔗 Lấy từ: https://dashboard.clerk.com
# Chuyển sang Production mode trước khi lấy key
# ============================================
CLERK_SECRET_KEY=CHANGE_ME_clerk_secret_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=CHANGE_ME_clerk_publishable_key

# ============================================
# STRIPE PAYMENTS
# 🔗 Lấy từ: https://dashboard.stripe.com/apikeys
# Dùng Test keys cho đồ án: sk_test_xxx, pk_test_xxx
# ============================================
STRIPE_SECRET_KEY=CHANGE_ME_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=CHANGE_ME_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=CHANGE_ME_stripe_webhook_secret

# ============================================
# GOOGLE GEMINI AI
# 🔗 Lấy từ: https://aistudio.google.com/apikey
# ============================================
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# SENTRY (Optional - Monitoring)
# Đặt SENTRY_DISABLED=true để tắt
# ============================================
SENTRY_DISABLED=true
SENTRY_DSN=

# ============================================
# ADMIN (Bull Board, Metrics)
# ============================================
ADMIN_PASSWORD=CHANGE_ME_admin_password
